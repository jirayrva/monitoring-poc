{
  "name": "device-monitor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "node --test \"{apps,packages,tooling}/**/*.unit.test.ts\"",
    "test:integration": "node --test \"{apps,packages,tooling}/**/*.integration.test.ts\"",
    "clean:dependencies": "rimraf \"**/node_modules\"",
    "clean": "pnpm clean:dependencies"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "rimraf": "^6.1.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.13.0"
  }
}
