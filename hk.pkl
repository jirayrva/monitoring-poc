// Git hooks, run by hk (https://hk.jdx.dev). mise install installs them with `hk install --mise`,
// so they run with the Node and pnpm that mise.toml pins, wherever git is started from.
// The version below must match hk's in mise.toml.
amends "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Builtins.pkl"

/**
 * One step per root script, and named after it, so hooks, CI and a run by hand share one
 * definition. Quick enough for every commit, and none of it needs Docker.
 * On commit, format and lint get only the staged files. The other steps check the whole project,
 * but only when files they cover changed. The push checks everything.
 */
local quick = new Mapping<String, Step> {
  // Fixes what it can, and hk stages the result. The builtin, for its glob and excludes.
  ["format"] = (Builtins.oxfmt) {
    check = "pnpm -s format:check {{files}}"
    // Otherwise hk would run oxfmt itself, rather than through the script.
    check_diff = null
    fix = "pnpm -s format {{files}}"
  }
  // Checks only: a lint fix changes code, so it should be looked at, not committed unseen.
  ["lint"] = (Builtins.ox_lint) {
    check = "pnpm -s lint {{files}}"
    fix = null
  }
  // The whole project, since one changed file can break another.
  ["typecheck"] {
    glob = List("**/*.ts", "**/*.tsx")
    check = "pnpm typecheck"
  }
  // The OpenAPI document, when it or its lint rules changed.
  ["lint:openapi"] {
    glob = List("packages/contracts/monitor-api/openapi.json", "packages/contracts/*redocly*.yaml")
    check = "pnpm lint:openapi"
  }
  // Seconds, and no database: the integration tests are the ones that need Postgres.
  ["test:unit"] {
    glob = List("**/*.ts", "**/*.tsx")
    check = "pnpm test:unit"
  }
}

// Also what `hk check` and `hk fix` run by hand.
steps = quick

hooks {
  ["pre-commit"] {
    fix = true
    // Sets unstaged edits aside while the hook runs, so it checks exactly what is committed.
    stash = "git"
    steps = quick
  }
  // Everything pnpm check runs, over the whole project, as CI does, so a push does not fail there.
  ["pre-push"] {
    steps {
      ["check"] {
        check = "pnpm check"
      }
    }
  }
}
